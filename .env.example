# Copy to .env.local for local development. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Supabase service_role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only override; defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# Comma-separated moderator emails. Server-only, lower/upper case accepted.
MODERATOR_EMAILS=
